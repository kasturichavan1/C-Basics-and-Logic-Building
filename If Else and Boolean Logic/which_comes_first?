#include <stdio.h>

int main() {
    int d1, m1, d2, m2;

    printf("Enter first date (day month): ");
    scanf("%d%d", &d1, &m1);

    printf("Enter second date (day month): ");
    scanf("%d%d", &d2, &m2);

    if(m1 < m2)
        printf("First date comes first");

    else if(m2 < m1)
        printf("Second date comes first");

    else {
        if(d1 < d2)
            printf("First date comes first");

        else if(d2 < d1)
            printf("Second date comes first");

        else
            printf("Both dates are same");
    }

    return 0;
}
